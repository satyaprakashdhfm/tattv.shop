# Copy to .env.local for local development, or set these as variables on the host.

# Public site address (links in WhatsApp messages to customers)
NEXT_PUBLIC_SITE_URL=https://tattv.shop

# ── Database (required) ──
# Local: run ../tattv-local-env (npm run db), then use:
DATABASE_URL=postgres://postgres:localdev@localhost:5434/tattv
# Hosted Postgres uses SSL automatically; set DATABASE_SSL=false to turn it off.

# ── Admin portal (/admin) ──
# Sign in with ADMIN_USERNAME (default "admin") and ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Long random string that signs admin sign-in cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Testing only: the login page shows test credentials (admin / tattv-test) with a one-click
# sign-in. Anyone can then get in, so remove it before launch.
# ADMIN_TEST_LOGIN=true

# ── Razorpay (online payments) ──
# Dashboard → Account & Settings → API Keys. Start with rzp_test_ keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional webhook (Settings → Webhooks → https://<site>/api/razorpay/webhook, event payment.captured)
RAZORPAY_WEBHOOK_SECRET=
# Without Razorpay keys, online payment is simulated in development. To allow that in production:
# DEMO_PAYMENTS=true

# ── Mobile login for customers (MSG91) ──
# Off until this is true (the account page shows only the preview account meanwhile):
# CUSTOMER_OTP_LOGIN=true
# MSG91's OTP widget (recommended): MSG91 texts the code with its default template and shows its captcha
# (switch the captcha on in the widget settings); our server confirms each sign-in with MSG91. Set all three:
MSG91_TOKEN=
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
# Or, without the widget: our own 6-digit code through a DLT-approved OTP template whose text uses ##OTP##.
# MSG91_TOKEN above, plus:
# MSG91_TEMPLATE_ID=
# With neither, local development shows the code on screen; the live site says mobile login is coming soon
# and offers the preview account instead. SESSION_SECRET (above) is required on the live site for sign-in.

# ── Delhivery (shipping) ──
# One Panel → Settings → API Setup. Staging and production tokens are different.
# Without a token, checkout accepts every PIN code and tracking is entered by hand in the admin.
DELIVERY_API_TOKEN=
# https://track.delhivery.com (production, default) or https://staging-express.delhivery.com
# DELHIVERY_BASE_URL=
# The warehouse (pickup location) name registered in the Delhivery panel, spelled exactly, and its PIN code
DELHIVERY_PICKUP_LOCATION=
DELHIVERY_ORIGIN_PIN=
# Default packed parcel weight in grams (the admin can type the real weight when booking)
# DELHIVERY_PARCEL_GRAMS=250
# Label size: 4R (4x6 thermal, default) or A4
# DELHIVERY_LABEL_SIZE=4R
# Scan push (webhook): a long random string. Ask Delhivery's tech team to push status updates to
# https://<site>/api/delhivery/webhook?token=<this>. The 30-minute check below stays on as the backup.
DELHIVERY_WEBHOOK_TOKEN=
# How often the server asks Delhivery about parcels on their way, in minutes (0 = off)
# DELHIVERY_POLL_MINUTES=30

# ── Google Search (SEO) ──
# Search Console ownership by HTML tag: the content="…" value (or verify by DNS and leave this empty)
GOOGLE_SITE_VERIFICATION=
# Search reports in Admin → Google Search: a Google Cloud service account key (the JSON file, pasted as one
# line), with the Search Console API switched on. Add its client_email as a user in Search Console.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: the Search Console property (default sc-domain:tattv.shop)
# SEARCH_CONSOLE_SITE=
