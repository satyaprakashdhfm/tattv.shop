# Copy to .env.local for local development, or set these as variables on the host.

# Public site address (links in WhatsApp messages to customers)
NEXT_PUBLIC_SITE_URL=https://tattv.shop

# ── Database (required) ──
# Local: run ../tattv-local-env (npm run db), then use:
DATABASE_URL=postgres://postgres:localdev@localhost:5434/tattv
# Hosted Postgres uses SSL automatically; set DATABASE_SSL=false to turn it off.

# ── Admin portal (/admin) ──
# Sign in with ADMIN_USERNAME (default "admin") and ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Long random string that signs admin sign-in cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Testing only: the login page shows test credentials (admin / tattv-test) with a one-click
# sign-in. Anyone can then get in, so remove it before launch.
# ADMIN_TEST_LOGIN=true

# ── Razorpay (online payments) ──
# Dashboard → Account & Settings → API Keys. Start with rzp_test_ keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional webhook (Settings → Webhooks → https://<site>/api/razorpay/webhook, event payment.captured)
RAZORPAY_WEBHOOK_SECRET=
# Without Razorpay keys, online payment is simulated in development. To allow that in production:
# DEMO_PAYMENTS=true
# Set to false to switch off cash on delivery:
# COD_ENABLED=true
